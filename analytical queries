WITH item_amounts AS (
    SELECT
        oi.order_id,
        o.order_date,
        oi.quantity * oi.unit_price *
            (1 - oi.discount / 100) AS sales,

        (oi.unit_price * (1 - oi.discount / 100)
            - p.cost) * oi.quantity AS profit

    FROM order_items AS oi
    JOIN orders AS o
        ON oi.order_id = o.order_id
    JOIN products AS p
        ON oi.product_id = p.product_id
)
SELECT
    YEAR(order_date) AS years,
    MONTH(order_date) AS months,
    SUM(sales) AS monthly_sales,
    SUM(profit) AS monthly_profit,
    COUNT(DISTINCT order_id) AS num_of_orders
FROM item_amounts
GROUP BY YEAR(order_date), MONTH(order_date)
ORDER BY years, months;

CREATE VIEW customer_wise_sales AS

WITH sales_amount AS (
    SELECT
        order_id,
        SUM(quantity * unit_price * (1 - discount / 100)) AS sales
    FROM order_items
    GROUP BY order_id
)

SELECT
    c.customer_id,
    c.customer_name,
    SUM(sa.sales) AS total_sales
FROM orders AS o
JOIN sales_amount AS sa
    ON o.order_id = sa.order_id
JOIN customers AS c
    ON c.customer_id = o.customer_id
GROUP BY
    c.customer_id,
    c.customer_name;
    
select *
from customer_wise_sales;

create view product_wise_sales as

select
	p.product_id,
    p.product_name,
    sum(oi.quantity)as total_quantity,
    sum(oi.quantity * oi.unit_price * (1-oi.discount  /100)) as total_sales,
    sum((oi.unit_price * (1 - oi.discount / 100)- p.cost) * oi.quantity )AS profit
from order_items as oi
join products as p
	on p.product_id = oi.product_id
group by p.product_id,p.product_name;

select *
from product_wise_sales;

WITH sales_amount AS (
    SELECT
        order_id,
        SUM(quantity * unit_price * (1 - discount / 100)) AS sales
    FROM order_items
    GROUP BY order_id
)
select
	c.customer_id,
    c.customer_name,
    sum(sa.sales)as total_sales,
    RANK() OVER (
        ORDER BY sum(sa.sales) DESC
    ) AS sales_rank
FROM orders AS o
JOIN sales_amount AS sa
    ON o.order_id = sa.order_id
JOIN customers AS c
    ON c.customer_id = o.customer_id
GROUP BY
    c.customer_id,
    c.customer_name;
   
