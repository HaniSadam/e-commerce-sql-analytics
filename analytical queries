select
	 distinct customer_id,
    year(order_date)as purchase_year,
    month(order_date) as purchase_month
from orders 
  )
select
 a.customer_id,
 a.purchase_year,
 a.purchase_month
from customer_months as a
left join customer_months as b
	on a.customer_id = b.customer_id
    and(
      (a.purchase_year=b.purchase_year
       and a.purchase_month + 1 = b.purchase_month)
      or
      (a.purchase_year +1 = b.purchase_year
       and a.purchase_month = 12
       and b.purchase_month = 1)
